renderer
{
	resolution 256 256
	enablebackground true
	enableskybox true
	envMap HDR/white_furnace_64x32.hdr
	enableuniformlight false
}

camera
{
	position 0.0 0.0 10.0
	lookat 0.0 0.0 0.0
	type orthographic
	orthographicHeight 2.5
	near 0.1
	far 50.0
}

material furnace_probe
{
	color 1.0 1.0 1.0
	roughness 0.5
	metallic 0.0
	ior 1.5
}

mesh
{
	file furnace/sphere.obj
	material furnace_probe
	position 0.0 0.0 0.0
}
